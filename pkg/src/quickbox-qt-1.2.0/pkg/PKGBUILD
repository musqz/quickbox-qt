# Maintainer: musqz
pkgname=quickbox-qt
pkgver=1.1.0
pkgrel=1
pkgdesc="Qt6/PySide6 GUI front-end for quickemu"
arch=('any')
url="https://github.com/musqz/quickbox-qt"
license=('MIT')
depends=(
    'python'
    'pyside6'
    'quickemu'
    'rsync'
    'xdg-utils'
)
optdepends=(
    'virt-viewer: SPICE display backend support'
)
conflicts=('quickbox')
provides=('quickbox')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('6bb95eebb7f035fb2307d263bdc953a5e4a63dc877893ce3e5bb0d33f9bc941a')

package() {
    cd "$srcdir/$pkgname-$pkgver"

    install -Dm755 quickbox        "$pkgdir/usr/bin/quickbox"
    install -Dm644 LICENSE         "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

    for f in translations/*.json; do
        install -Dm644 "$f" "$pkgdir/usr/share/$pkgname/$f"
    done

    install -Dm644 pkg/quickbox.desktop \
        "$pkgdir/usr/share/applications/quickbox.desktop"

    # Icons
    for size in 16 22 24 32 48 64 96 128 256 512; do
        install -Dm644 "icons/hicolor/${size}x${size}/apps/quickbox.png" \
            "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/quickbox.png"
    done

    # Version
    install -Dm644 version.txt "$pkgdir/usr/share/quickbox-qt/version.txt"
}

post_install() {
    gtk-update-icon-cache -q -t -f usr/share/icons/hicolor
}

post_upgrade() {
    post_install
}

post_remove() {
    gtk-update-icon-cache -q -t -f usr/share/icons/hicolor
}
