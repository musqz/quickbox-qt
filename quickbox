    # ── launch / stop ─────────────────────────────────────────────────────────────
    def _launch_vm(self, vm):
        vmname    = vm["_name"]
        vmdir     = str(Path(self.vms_dir) / vmname)
        conf_path = vm["_conf"]
        ssh_port  = vm.get("ssh_port", "")
        if not ssh_port:
            ssh_port = get_next_ssh_port(self.vms_dir, vmname)
            setconf("ssh_port", ssh_port, conf_path)
            vm["ssh_port"] = ssh_port

        disk_img  = vm.get("disk_img", "")
        disk_path = str(Path(self.vms_dir) / disk_img) if disk_img else ""
        if disk_path and not Path(disk_path).exists():
            Path(vmdir).mkdir(parents=True, exist_ok=True)
            disk_size = vm.get("disk_size", "32G")
            subprocess.run(["qemu-img", "create", "-f", "qcow2", disk_path, disk_size])

        accel = "kvm" if KVM_AVAILABLE else "tcg"
        quiet = vm.get("quiet_launch") == "true"

        cmd = ["quickemu", "--vm", conf_path, "--display", "sdl"]
        subprocess.Popen(cmd, cwd=self.vms_dir)
        if not quiet:
            notify("quickbox", S["ntf_launching"].format(vmname), "low")
        setconf("snap_dirty", "true", conf_path)
        QTimer.singleShot(3000, self._refresh)

    def _stop_vm(self, vm):
        try:
            subprocess.run(["pkill", "-f", f"quickemu.*{vm['_name']}"])
        except Exception:
            pass
        QTimer.singleShot(1500, self._refresh)

    # ── snapshots ─────────────────────────────────────────────────────────────────
    def _snap_create(self, vm):
        tag = self._snap_entry.text().strip()
        if not tag:
            return
        if vm["_running"]:
            self._warn(S["warn_snap_fail_t"], S["warn_snap_running_b"])
            return
        snaps = get_snapshots(vm["_disk"])
        if any(s["tag"] == tag for s in snaps):
            self._warn(S["warn_dup_snap_t"], S["warn_dup_snap_b"].format(tag))
            return
        worker = SnapWorker("create", vm["_disk"], tag)
        worker.done.connect(lambda ok, err, v=vm, t=tag: self._on_snap_done(ok, err, "create", v, t))
        worker.start()

    def _snap_delete(self, vm, tag):
        if not self._confirm(S["dlg_snap_del_t"].format(tag), S["dlg_snap_del_b"]):
            return
        worker = SnapWorker("delete", vm["_disk"], tag)
        worker.done.connect(lambda ok, err, v=vm: (
            notify("quickbox", S["ntf_snap_applied"].format(tag)) if ok else
            self._warn(S["warn_snap_fail_t"], err),
            self._show_panel(v)))
        worker.start()

    def _snap_apply(self, vm, tag):
        auto_tag = f"pre-apply-{_date_tag(with_time=True)}"
        disk_unchanged = (vm.get("current_snap") == tag and vm.get("snap_dirty") != "true")

        dlg = QDialog(self)
        dlg.setWindowTitle(S["dlg_snap_apply_t"].format(tag))
        dlg.setWindowIcon(QIcon.fromTheme("qemu"))
        dlg.resize(460, 200)
        v = QVBoxLayout(dlg)

        warn = QLabel(S["dlg_snap_apply_b"])
        warn.setWordWrap(True)
        v.addWidget(warn)

        save_row = QWidget()
        sr = QHBoxLayout(save_row)
        if disk_unchanged:
            chk = QCheckBox(S["snap_autosave_skip"])
            chk.setEnabled(False)
            sr.addWidget(chk)
        else:
            chk = QCheckBox(S["snap_autosave_chk"])
            chk.setChecked(True)
            name_entry = QLineEdit(auto_tag)
            name_entry.setMinimumWidth(200)
            chk.toggled.connect(name_entry.setEnabled)
            sr.addWidget(chk)
            sr.addWidget(name_entry)
        v.addWidget(save_row)

        btns = QDialogButtonBox(QDialogButtonBox.StandardButton.Ok | QDialogButtonBox.StandardButton.Cancel)
        btns.button(QDialogButtonBox.StandardButton.Ok).setText(S["snap_apply"])
        btns.accepted.connect(dlg.accept)
        btns.rejected.connect(dlg.reject)
        v.addWidget(btns)

        if dlg.exec() != QDialog.DialogCode.Accepted:
            return

        save_first = not disk_unchanged and chk.isChecked()
        save_name  = name_entry.text().strip() if save_first else auto_tag

        def _do_apply():
            if save_first:
                r = subprocess.run(["qemu-img", "snapshot", "-c", save_name, vm["_disk"]],
                                   capture_output=True)
                if r.returncode == 0:
                    notify("quickbox", S["snap_autosave_done"].format(save_name))
            r2 = subprocess.run(["qemu-img", "snapshot", "-a", tag, vm["_disk"]],
                                 capture_output=True, text=True)
            if r2.returncode == 0:
                setconf("current_snap", tag, vm["_conf"])
                setconf("snap_dirty", "false", vm["_conf"])
                vm["current_snap"] = tag
                notify("quickbox", S["ntf_snap_applied"].format(tag))
            QMetaObject.invokeMethod(self, "_refresh_panel", Qt.ConnectionType.QueuedConnection,
                                     Q_ARG(object, vm))

        threading.Thread(target=_do_apply, daemon=True).start()

    def _on_snap_done(self, ok, err, action, vm, tag):
        if ok:
            if action == "create":
                notify("quickbox", S["ntf_snap_created"].format(tag))
        else:
            self._warn(S["warn_snap_fail_t"], err)
        self._show_panel(vm)

