        self._expanded = not self._expanded
        for w in self._content:
            w.setVisible(self._expanded)
        self.btn.setText(S["btn_hide"] if self._expanded else S["btn_show"])
        val = "true" if self._expanded else "false"
        setconf(self.conf_key, val)
        self.conf[self.conf_key] = val


# ── main window ────────────────────────────────────────────────────────────────
class QuickboxWindow(QMainWindow):
    def __init__(self):
        super().__init__()
        self.conf        = read_conf()
        self.vms_dir     = self.conf.get("vms_dir", str(Path.home() / "emu"))
        self.vms         = []
        self.current_vm  = None
        self._any_importing = False
        self._conf_mtimes   = {}
        self._vms_dir_mtime = 0

        # Clean stale copy flags
        for f in Path(self.vms_dir).glob(".*.copying"):
            f.unlink(missing_ok=True)

        ensure_default_profiles()
        self._build_ui()
        self._build_tray()
        self._init_ipc()
        self._refresh()

        # Timers
        self._t_state   = QTimer(self); self._t_state.timeout.connect(self._poll_running_state); self._t_state.start(4000)
        self._t_dir     = QTimer(self); self._t_dir.timeout.connect(self._poll_vms_dir);        self._t_dir.start(4000)
        self._t_copy    = QTimer(self); self._t_copy.timeout.connect(self._poll_copying);       self._t_copy.start(2000)

        self.setWindowIcon(QIcon.fromTheme("qemu"))

    # ── UI skeleton ─────────────────────────────────────────────────────────────
    def _build_ui(self):
        self.setWindowTitle(S["app_title"])
        self.resize(int(self.conf.get("win_w", "900")),
                    int(self.conf.get("win_h", "620")))
        self.setMinimumSize(720, 480)

        # toolbar
        tb = QToolBar()
        tb.setMovable(False)
        tb.setIconSize(QSize(16, 16))

        self._tray_btn = QPushButton(f"⊡  {S['hdr_tray']}")
        self._tray_btn.setCheckable(True)
        self._tray_btn.setChecked(self.conf.get("systray") == "true")
        self._tray_btn.setToolTip(S["tt_tray"])
        self._tray_btn.toggled.connect(self._on_tray_toggle)
        tb.addWidget(self._tray_btn)
        tb.addSeparator()

        self._hdr_btns = []
        for label, tip, cb in [
            (S["hdr_download"],  S["tt_download"],  self._dlg_download),
            (S["hdr_custom_vm"], S["tt_custom_vm"], self._dlg_custom),
            (S["hdr_advanced"],  S["tt_advanced"],  self._dlg_advanced),
        ]:
            btn = QPushButton(label)
            btn.setToolTip(tip)
            btn.clicked.connect(cb)
            tb.addWidget(btn)
            self._hdr_btns.append(btn)

        self.addToolBar(tb)

        # splitter
        splitter = QSplitter(Qt.Orientation.Horizontal)

        # left: search + list
        left = QWidget()
        lv   = QVBoxLayout(left)
        lv.setContentsMargins(4, 4, 4, 4)
        lv.setSpacing(4)

        self._search = QLineEdit()
        self._search.setPlaceholderText(S["search_ph"])
        self._search.textChanged.connect(self._on_search)
        lv.addWidget(self._search)

        self._list = QListWidget()
        self._list.setHorizontalScrollBarPolicy(Qt.ScrollBarPolicy.ScrollBarAlwaysOff)
        self._list.setSelectionMode(QAbstractItemView.SelectionMode.SingleSelection)
        self._list.currentItemChanged.connect(self._on_select)
        lv.addWidget(self._list)

        splitter.addWidget(left)

        # right: scroll area
        self._right_scroll = QScrollArea()
        self._right_scroll.setWidgetResizable(True)
        self._right_scroll.setHorizontalScrollBarPolicy(Qt.ScrollBarPolicy.ScrollBarAlwaysOff)
        self._right_widget = QWidget()
        self._right_layout = QVBoxLayout(self._right_widget)
        self._right_layout.setContentsMargins(16, 12, 16, 16)
        self._right_layout.setSpacing(4)
        self._right_layout.addStretch()
        self._right_scroll.setWidget(self._right_widget)
        splitter.addWidget(self._right_scroll)

        splitter.setSizes([280, 620])
        splitter.setStretchFactor(0, 0)
        splitter.setStretchFactor(1, 1)
        self.setCentralWidget(splitter)

        # status bar
        self._status = QStatusBar()
        self._status.setSizeGripEnabled(False)
        self.setStatusBar(self._status)

        self._show_welcome()

    def _clear_right(self):
        while self._right_layout.count():
            item = self._right_layout.takeAt(0)
            if item.widget():
                item.widget().deleteLater()

    def _show_welcome(self):
        self._clear_right()
        lbl = QLabel(S["welcome"])
        lbl.setAlignment(Qt.AlignmentFlag.AlignCenter)
        lbl.setStyleSheet("font-size: 14px;")
        self._right_layout.addStretch()
        self._right_layout.addWidget(lbl, alignment=Qt.AlignmentFlag.AlignCenter)
        self._right_layout.addStretch()

    # ── refresh ──────────────────────────────────────────────────────────────────
    def _refresh(self):
        current_name = self.current_vm["_name"] if self.current_vm else None
        search = self._search.text().lower()

        self._list.blockSignals(True)
        self._list.clear()
        self.vms = get_vms(self.vms_dir)

        for vm in self.vms:
            if search and search not in vm["_pretty"].lower() and search not in vm["_name"].lower():
                continue
            item = QListWidgetItem()
            widget = VMItemWidget(vm)
            item.setSizeHint(widget.sizeHint())
            item.setData(Qt.ItemDataRole.UserRole, vm)
            self._list.addItem(item)
            self._list.setItemWidget(item, widget)

        importing = any(v.get("_copying") for v in self.vms)
        self._any_importing = importing
        for b in self._hdr_btns:
            b.setEnabled(not importing)

        n = len(self.vms)
        label = S["status_vms_pl"].format(n) if n != 1 else S["status_vms"].format(n)
        self._status.showMessage(f"{self.vms_dir}  •  {label}")

        # re-select
        if current_name:
            for i in range(self._list.count()):
                vm = self._list.item(i).data(Qt.ItemDataRole.UserRole)
                if vm and vm["_name"] == current_name:
                    self._list.setCurrentRow(i)
                    self.current_vm = vm
                    break

        self._list.blockSignals(False)
        return False

    def _on_search(self, text):
        self._refresh()

    def _on_select(self, current, _prev):
        if current:
            vm = current.data(Qt.ItemDataRole.UserRole)
            if vm:
                self.current_vm = vm
                self._show_panel(vm)

    # ── polling ───────────────────────────────────────────────────────────────────
    def _poll_running_state(self):
        if not self.vms:
            return
        changed = any(is_running(v["_name"]) != v["_running"] for v in self.vms)
        if changed:
            self._refresh()
            if self.current_vm:
                self._show_panel(self.current_vm)

    def _poll_vms_dir(self):
        try:
            mtime = os.stat(self.vms_dir).st_mtime
            if mtime != self._vms_dir_mtime:
                if self._vms_dir_mtime != 0:
                    self._refresh()
                    if self.current_vm:
                        self._show_panel(self.current_vm)
                self._vms_dir_mtime = mtime
            changed = False
            for p in Path(self.vms_dir).glob("*.conf"):
                m = p.stat().st_mtime
                if self._conf_mtimes.get(str(p)) != m:
                    changed = True
                    self._conf_mtimes[str(p)] = m
            if changed and self._vms_dir_mtime != 0:
                self._refresh()
                if self.current_vm:
                    self._show_panel(self.current_vm)
        except Exception:
            pass

    def _poll_copying(self):
        if list(Path(self.vms_dir).glob(".*.copying")):
            self._refresh()

    # ── IPC ───────────────────────────────────────────────────────────────────────
    def _init_ipc(self):
        self._ipc_notifier = QSocketNotifier(
            _lock_socket.fileno(), QSocketNotifier.Type.Read, self)
        self._ipc_notifier.activated.connect(self._on_ipc)

    def _on_ipc(self, fd):
        try:
            conn, _ = _lock_socket.accept()
            msg = conn.recv(64).decode().strip()
            conn.close()
            if "activate" in msg:
                self.show()
                self.raise_()
                self.activateWindow()
        except Exception:
            pass

    # ── systray ───────────────────────────────────────────────────────────────────
    def _build_tray(self):
        self._tray = QSystemTrayIcon(QIcon.fromTheme("qemu"), self)
        menu = QMenu()
        show_act = QAction("Show / Hide", self)
        show_act.triggered.connect(self._tray_toggle)
        quit_act = QAction("Quit", self)
        quit_act.triggered.connect(QApplication.quit)
        menu.addAction(show_act)
        menu.addSeparator()
        menu.addAction(quit_act)
        self._tray.setContextMenu(menu)
        self._tray.activated.connect(lambda r: self._tray_toggle() if r == QSystemTrayIcon.ActivationReason.Trigger else None)
        if self.conf.get("systray") == "true":
            self._tray.show()

    def _tray_toggle(self):
        if self.isVisible():
            self.hide()
        else:
            self.show()
            self.raise_()
            self.activateWindow()

    def _on_tray_toggle(self, checked):
        setconf("systray", "true" if checked else "false")
        self.conf["systray"] = "true" if checked else "false"
        if checked:
            self._tray.show()
        else:
            self._tray.hide()

    def closeEvent(self, event):
        if self._tray.isVisible() and self.conf.get("systray") == "true":
            self.hide()
            event.ignore()
        else:
            self.conf["win_w"] = str(self.width())
            self.conf["win_h"] = str(self.height())
            setconf("win_w", str(self.width()))
            setconf("win_h", str(self.height()))
            event.accept()

    def keyPressEvent(self, event):
        if event.key() == Qt.Key.Key_F5 or (event.modifiers() & Qt.KeyboardModifier.ControlModifier and event.key() == Qt.Key.Key_R):
            self._refresh()
        super().keyPressEvent(event)

