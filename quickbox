        hint.setStyleSheet("font-size:11px;")
        v.addWidget(hint)
        btns = QDialogButtonBox(QDialogButtonBox.StandardButton.Ok | QDialogButtonBox.StandardButton.Cancel)
        btns.button(QDialogButtonBox.StandardButton.Ok).setText(S["btn_clone"])
        btns.accepted.connect(dlg.accept)
        btns.rejected.connect(dlg.reject)
        v.addWidget(btns)
        if dlg.exec() != QDialog.DialogCode.Accepted:
            return

        dest_name = entry.text().strip()
        if not dest_name:
            return
        dest_conf = Path(self.vms_dir) / f"{dest_name}.conf"
        dest_dir  = Path(self.vms_dir) / dest_name
        src_dir   = Path(self.vms_dir) / vm["_name"]
        src_conf  = Path(vm["_conf"])
        if dest_conf.exists() or dest_dir.exists():
            self._warn(S["warn_exists_t"], S["warn_exists_b"].format(dest_name))
            return

        try:
            src_vm = read_vm_conf(str(src_conf))
            skip_keys = {"vm_ram", "vm_cpu", "ssh_port"}
            out = ["#!/usr/bin/quickemu --vm"]
            for k, val in src_vm.items():
                if k in skip_keys:
                    continue
                if k == "pretty":
                    out.append(f'pretty="{dest_name}"')
                elif k in {"disk_img", "iso"} and val and vm["_name"] in val:
                    out.append(f'{k}="{val.replace(vm["_name"], dest_name)}"')
                elif val:
                    out.append(f'{k}="{val}"')
                else:
                    out.append(f'{k}=')
            if "pretty" not in src_vm:
                out.append(f'pretty="{dest_name}"')
            new_port = get_next_ssh_port(self.vms_dir, dest_name)
            out.append(f'ssh_port="{new_port}"')
            dest_conf.write_text("\n".join(out) + "\n")
            dest_conf.chmod(0o755)
        except Exception as e:
            self._warn(S["warn_clone_t"], S["warn_clone_conf"].format(e))
            return

        self._refresh()
        flag = Path(self.vms_dir) / f".{dest_name}.copying"
        flag.touch()

        worker = CopyWorker(src_dir, dest_dir, flag, vm["_name"])
        worker.done.connect(lambda ok, err: (
            notify("quickbox", S["ntf_clone_done"].format(dest_name)) if ok
            else self._warn(S["warn_clone_t"], S["warn_clone_dir"].format(err)),
            self._refresh()),
            Qt.ConnectionType.QueuedConnection)
        self._track_worker(worker)
        worker.start()

