    def _dlg_custom(self, *_):
        src_path, _ = QFileDialog.getOpenFileName(
            self, S["cvm_file_title"], str(Path.home()),
            "Disk images (*.iso *.img)")
        if not src_path:
            return
        src_path = Path(src_path)

        dlg = QDialog(self)
        dlg.setWindowTitle(S["cvm_title"])
        dlg.setWindowIcon(QIcon.fromTheme("qemu"))
        dlg.resize(380, 150)
        v = QVBoxLayout(dlg)
        v.addWidget(QLabel(S["cvm_name_lbl"]))
        name_entry = QLineEdit(src_path.stem.replace(" ", "-"))
        v.addWidget(name_entry)
        btns = QDialogButtonBox(QDialogButtonBox.StandardButton.Ok | QDialogButtonBox.StandardButton.Cancel)
        btns.button(QDialogButtonBox.StandardButton.Ok).setText(S["btn_next"])
        btns.accepted.connect(dlg.accept)
        btns.rejected.connect(dlg.reject)
        v.addWidget(btns)
        if dlg.exec() != QDialog.DialogCode.Accepted:
            return

        vm_name = name_entry.text().strip().replace(" ", "-")
        if not vm_name:
            return

        dest_name = vm_name
        dest_conf = Path(self.vms_dir) / f"{dest_name}.conf"
        dest_dir  = Path(self.vms_dir) / dest_name
        if dest_conf.exists():
            self._warn(S["warn_exists_t"], S["warn_exists_b"].format(dest_name))
            return

        ssh_port = get_next_ssh_port(self.vms_dir, dest_name)
        dest_dir.mkdir(parents=True, exist_ok=True)
        is_img = src_path.suffix.lower() == ".img"

        flag = Path(self.vms_dir) / f".{dest_name}.copying"
        flag.write_text(str(src_path.stat().st_size))
        self._refresh()

        if is_img:
            disk = str(dest_dir / "disk.qcow2")
            conf_text = (f"#!/usr/bin/quickemu --vm\nguest_os=\"linux\"\n"
                         f"disk_img=\"{dest_name}/disk.qcow2\"\n"
                         f"pretty=\"{vm_name}\"\nssh_port=\"{ssh_port}\"\n"
                         f"boot=legacy\ncompat_mode=true\ndisk_if=ide\nnet_device=e1000\n")
            dest_conf.write_text(conf_text)
            dest_conf.chmod(0o755)
            notify("quickbox", S["ntf_converting"].format(src_path.name), "low")
            worker = ConvertWorker(str(src_path), disk)
            worker.done.connect(lambda ok, err: (
                flag.unlink(missing_ok=True),
                notify("quickbox", f"VM {vm_name} created!") if ok
                else self._warn("Conversion failed", err),
                self._refresh()))
            worker.start()
        else:
            dest_iso = dest_dir / src_path.name
            conf_text = (f"#!/usr/bin/quickemu --vm\nguest_os=\"linux\"\n"
                         f"disk_img=\"{dest_name}/disk.qcow2\"\n"
                         f"iso=\"{dest_name}/{src_path.name}\"\n"
                         f"pretty=\"{vm_name}\"\nssh_port=\"{ssh_port}\"\n")
            dest_conf.write_text(conf_text)
            dest_conf.chmod(0o755)
            notify("quickbox", S["ntf_copying"].format(src_path.name), "low")
            worker = CopyWorker(src_path, dest_iso, flag)
            worker.done.connect(lambda ok, err: (
                notify("quickbox", f"VM {vm_name} created!") if ok
                else self._warn("Copy failed", err),
                self._refresh()))
            worker.start()

