    def _launch_vm(self, vm):
        vmname    = vm["_name"]
        vmdir     = str(Path(self.vms_dir) / vmname)
        conf_path = vm["_conf"]
        ssh_port  = vm.get("ssh_port", "")
        if not ssh_port:
            ssh_port = get_next_ssh_port(self.vms_dir, vmname)
            setconf("ssh_port", ssh_port, conf_path)
            vm["ssh_port"] = ssh_port

        disk_img  = vm.get("disk_img", "")
        disk_path = str(Path(self.vms_dir) / disk_img) if disk_img else ""
        if disk_path and not Path(disk_path).exists():
            Path(vmdir).mkdir(parents=True, exist_ok=True)
            disk_size = vm.get("disk_size", "32G")
            subprocess.run(["qemu-img", "create", "-f", "qcow2", disk_path, disk_size])

        accel = "kvm" if KVM_AVAILABLE else "tcg"
        quiet = vm.get("quiet_launch") == "true"

        display = vm.get("display", "sdl")
        cmd = ["quickemu", "--vm", conf_path, "--display", display]
        subprocess.Popen(cmd, cwd=self.vms_dir)
        if not quiet:
            notify("quickbox", S["ntf_launching"].format(vmname), "low")
        setconf("snap_dirty", "true", conf_path)
        self._poll_vm_state(vmname, want_running=True)

    def _stop_vm(self, vm):
        try:
            subprocess.run(["pkill", "-TERM", "-f", f"name {vm['_name']},process={vm['_name']}"])
        except Exception:
            pass
        self._poll_vm_state(vm["_name"], want_running=False)

    def _poll_vm_state(self, vmname, want_running, _attempts=20):
        if is_running(vmname) == want_running:
            self._refresh()
            if self.current_vm and self.current_vm["_name"] == vmname:
                fresh = next((v for v in self.vms if v["_name"] == vmname), None)
                if fresh:
                    self._show_panel(fresh)
            return
        if _attempts > 0:
            QTimer.singleShot(500, lambda: self._poll_vm_state(vmname, want_running, _attempts - 1))

    # ── snapshots ─────────────────────────────────────────────────────────────────
    def _snap_create(self, vm):
        tag = self._snap_entry.text().strip()
        if not tag:
            return
        if vm["_running"]:
            self._warn(S["warn_snap_fail_t"], S["warn_snap_running_b"])
            return
        snaps = get_snapshots(vm["_disk"])
        if any(s["tag"] == tag for s in snaps):
            self._warn(S["warn_dup_snap_t"], S["warn_dup_snap_b"].format(tag))
            return
        worker = SnapWorker("create", vm["_disk"], tag)
        worker.done.connect(lambda ok, err, v=vm, t=tag: self._on_snap_done(ok, err, "create", v, t))
        self._status.showMessage(S["snap_creating"].format(tag))
        self._track_worker(worker)
        worker.start()

    def _snap_delete(self, vm, tag):
        if not self._confirm(S["dlg_snap_del_t"].format(tag), S["dlg_snap_del_b"]):
            return
        worker = SnapWorker("delete", vm["_disk"], tag)
        worker.done.connect(lambda ok, err, v=vm: (
            notify("quickbox", S["ntf_snap_applied"].format(tag)) if ok else
            self._warn(S["warn_snap_fail_t"],
                       S["warn_snap_locked"] if ("write" in err.lower() or "lock" in err.lower()) else err),
            self._refresh_and_show(v)))
        self._status.showMessage(S["snap_deleting"].format(tag))
        self._track_worker(worker)
        worker.start()

