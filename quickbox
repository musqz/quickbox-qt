            dlg.exec()
            return

        dlg = QDialog(self)
        dlg.setWindowTitle(S["dl_title"])
        dlg.setWindowIcon(QIcon.fromTheme("quickbox"))
        dlg.resize(640, 520)
        dlg.setMinimumSize(640, 460)
        v = QVBoxLayout(dlg)

        search = QLineEdit()
        search.setPlaceholderText(S["dl_search_ph"])
        v.addWidget(search)

        h = QHBoxLayout()

        # alphabet sidebar
        from PySide6.QtWidgets import QScrollArea as _SA
        alpha_scroll = _SA()
        alpha_scroll.setWidgetResizable(True)
        alpha_scroll.setFixedWidth(46)
        alpha_scroll.setHorizontalScrollBarPolicy(Qt.ScrollBarPolicy.ScrollBarAlwaysOff)
        alpha_w = QWidget()
        alpha_v = QVBoxLayout(alpha_w)
        alpha_v.setContentsMargins(2, 2, 2, 2)
        alpha_v.setSpacing(1)
        alpha_scroll.setWidget(alpha_w)
        h.addWidget(alpha_scroll)

        sep = make_sep(False)
        h.addWidget(sep)

        # distro list
        dist_list = QListWidget()
        dist_list.setHorizontalScrollBarPolicy(Qt.ScrollBarPolicy.ScrollBarAlwaysOff)
        h.addWidget(dist_list, 1)
        v.addLayout(h)

        hint = QLabel(S["dl_hint2"])
        hint.setStyleSheet("font-size:11px;")
        v.addWidget(hint)

        close_btn = QPushButton(S["btn_close"])
        close_btn.clicked.connect(dlg.close)
        v.addWidget(close_btn)

        # populate
        letter_rows = {}
        all_items   = []
        for name, cmd in distros:
            first = name[0].upper() if name else "?"
            if first not in letter_rows:
                hdr_item = QListWidgetItem(f"── {first} ──")
                hdr_item.setFlags(Qt.ItemFlag.NoItemFlags)
                dist_list.addItem(hdr_item)
                letter_rows[first] = hdr_item
            item = QListWidgetItem(f"  {name}")
            item.setData(Qt.ItemDataRole.UserRole, (name, cmd))
            dist_list.addItem(item)
            all_items.append((name, cmd, item))

        # alphabet buttons
        for letter in sorted(letter_rows.keys()):
            btn = QPushButton(letter)
            btn.setFlat(True)
            btn.setFixedSize(34, 26)
            def _jump(_, ltr=letter, lrows=letter_rows, dl=dist_list):
                dl.scrollToItem(lrows[ltr], QAbstractItemView.ScrollHint.PositionAtTop)
            btn.clicked.connect(_jump)
            alpha_v.addWidget(btn)
        alpha_v.addStretch()

        def _filter(text):
            t = text.strip().lower()
            for name, cmd, item in all_items:
                item.setHidden(bool(t) and t not in name.lower())
            for letter, hdr in letter_rows.items():
                any_visible = any(
                    not item.isHidden()
                    for n, c, item in all_items
                    if n and n[0].upper() == letter)
                hdr.setHidden(bool(t) and not any_visible)

        search.textChanged.connect(_filter)

        class _KbFilter(QObject):
            def eventFilter(self, obj, event):
                if event.type() != QEvent.Type.KeyPress:
                    return False
                key = event.key()
                if obj is search:
                    if key == Qt.Key.Key_Escape:
                        if search.text():
                            search.clear()
                            return True
                    elif key in (Qt.Key.Key_Down, Qt.Key.Key_Return, Qt.Key.Key_Enter):
                        dist_list.setFocus()
                        for i in range(dist_list.count()):
                            it = dist_list.item(i)
                            if not it.isHidden() and it.flags() & Qt.ItemFlag.ItemIsSelectable:
                                dist_list.setCurrentRow(i)
                                break
                        return True
                elif obj is dist_list:
                    if key == Qt.Key.Key_Up:
                        cur = dist_list.currentRow()
                        has_above = any(
                            not dist_list.item(i).isHidden() and
                            bool(dist_list.item(i).flags() & Qt.ItemFlag.ItemIsSelectable)
                            for i in range(cur) if dist_list.item(i)
                        )
                        if not has_above:
                            search.setFocus()
                            return True
                return False

        _kb = _KbFilter(dlg)
        search.installEventFilter(_kb)
        dist_list.installEventFilter(_kb)
        QWidget.setTabOrder(search, dist_list)
        QWidget.setTabOrder(dist_list, close_btn)

        selected = [None]

        def _on_activate(item):
            data = item.data(Qt.ItemDataRole.UserRole)
            if data:
                selected[0] = data
                dlg.accept()

        dist_list.itemDoubleClicked.connect(_on_activate)
        dist_list.itemActivated.connect(_on_activate)

        search.setFocus()
        while True:
            if dlg.exec() != QDialog.DialogCode.Accepted or not selected[0]:
                break
            name, cmd = selected[0]
            selected[0] = None
            dlg.close()
            self._dlg_do_download(name, cmd, distros)
            break

    def _dlg_do_download(self, distro_name, distro_cmd, distros):
        cmd_parts  = distro_cmd.split()
        base_distro = cmd_parts[1] if len(cmd_parts) > 1 else distro_name
        versions = [(name, cmd) for name, cmd in distros
                    if len(cmd.split()) > 1 and cmd.split()[1].lower() == base_distro.lower()]
        if not versions:
            versions = [(distro_name, distro_cmd)]

        dlg = QDialog(self)
        dlg.setWindowTitle(f"Download — {base_distro}")
        dlg.setWindowIcon(QIcon.fromTheme("quickbox"))
        dlg.resize(560, 320)
        v = QVBoxLayout(dlg)

        title = QLabel(f"<b><span style='font-size:15px'>{html.escape(base_distro.title())}</span></b>")
        title.setTextFormat(Qt.TextFormat.RichText)
        v.addWidget(title)
        v.addWidget(make_sep())

        vl = QLabel(S["dl2_ver_lbl"])
        v.addWidget(vl)
        ver_combo = QComboBox()
        for name, _ in versions:
            ver_combo.addItem(name)
        default_idx = next((i for i, (n, _) in enumerate(versions) if n == distro_name), 0)
        ver_combo.setCurrentIndex(default_idx)
        v.addWidget(ver_combo)

        cmd_lbl = QLabel(S["dl2_cmd_lbl"])
        v.addWidget(cmd_lbl)
        cmd_entry = QLineEdit(versions[default_idx][1])
        cmd_entry.setReadOnly(True)
        ver_combo.currentIndexChanged.connect(lambda i: cmd_entry.setText(versions[i][1]))
        v.addWidget(cmd_entry)

        cli_hint = QLabel(f"If the GUI download fails, run the command above in a terminal from <b>{html.escape(self.vms_dir)}</b> — the VM will appear in the list automatically.")
        cli_hint.setTextFormat(Qt.TextFormat.RichText)
        cli_hint.setWordWrap(True)
        cli_hint.setStyleSheet("font-size:11px;")
        v.addWidget(cli_hint)
        v.addWidget(make_sep())

        progress = QProgressBar()
        progress.setRange(0, 1000)
        progress.setValue(0)
        progress.setFormat(S["dl2_ready"])
        progress.setTextVisible(True)
        v.addWidget(progress)

        note = QLabel(S["dl2_note"])
        note.setStyleSheet("font-size:11px;")
        v.addWidget(note)

        btn_row = QWidget()
        br = QHBoxLayout(btn_row)
        cancel_btn = QPushButton(S["btn_cancel"])
        dl_btn     = QPushButton(S["btn_download"])
        dl_btn.setStyleSheet("background:#1565c0;color:white;border-radius:5px;padding:5px 14px;font-weight:bold;")
        dl_btn.setDefault(True)
        br.addStretch()
        br.addWidget(cancel_btn)
        br.addWidget(dl_btn)
        v.addWidget(btn_row)
        QWidget.setTabOrder(ver_combo, dl_btn)
        QWidget.setTabOrder(dl_btn, cancel_btn)

        self._dl_worker = None
        t0 = [0.0]
        _dl_ok = [False]
        _done = [False]

        def _on_progress(text, frac):
            if frac < 0:
                if progress.maximum() != 0:
                    progress.setRange(0, 0)   # pulsing indeterminate bar
            else:
                if progress.maximum() == 0:
                    progress.setRange(0, 1000)
                progress.setValue(int(frac * 1000))
            progress.setFormat(text)

        def _on_done(ok):
            import time
            elapsed = time.monotonic() - t0[0]
            m, s = divmod(int(elapsed), 60)
            dur = f"{m}m {s}s" if m else f"{s}s"
            _dl_ok[0] = ok
            if not _done[0]:
                if ok:
                    note.setText(f"Downloaded in {dur}")
                    dl_btn.setText(S["dl2_done_close"])
                else:
                    dl_btn.setText(S["btn_close"])
                dl_btn.setEnabled(True)
                cancel_btn.setEnabled(False)
                dl_btn.setFocus()
            self._refresh()

        def _start():
            import time
            t0[0] = time.monotonic()
            cmd = cmd_entry.text().strip().split()
            dl_btn.setEnabled(False)
            ver_combo.setEnabled(False)
            self._dl_worker = DownloadWorker(cmd, self.vms_dir)
            self._dl_worker.progress.connect(_on_progress)
            self._dl_worker.done.connect(_on_done)
            self._dl_worker.start()
            cancel_btn.setFocus()

        def _cancel():
            if _done[0]:
                return
            _done[0] = True
            if self._dl_worker:
                self._dl_worker.cancel()
            dlg.close()

        def _on_dialog_close():
            # Called via finished signal — dialog is already closing, only cancel the worker.
            if _done[0]:
                return
            _done[0] = True
            if self._dl_worker:
                self._dl_worker.cancel()

        def _close_and_select():
            _done[0] = True
            dlg.close()
            if _dl_ok[0]:
                try:
                    confs = sorted(Path(self.vms_dir).glob("*.conf"),
                                   key=lambda p: p.stat().st_mtime, reverse=True)
                    if confs:
                        newest = confs[0].stem
                        for i in range(self._list.count()):
                            vm = self._list.item(i).data(Qt.ItemDataRole.UserRole)
                            if vm and vm["_name"] == newest:
                                self._list.setCurrentRow(i)
                                self._show_panel(vm)
                                break
                except Exception:
                    pass

        dl_btn.clicked.connect(lambda: _close_and_select() if dl_btn.text() in (S["dl2_done_close"], S["btn_close"]) else _start())
        cancel_btn.clicked.connect(_cancel)
        dlg.finished.connect(_on_dialog_close)
        dlg.show()

