# ── config helpers ─────────────────────────────────────────────────────────────
def read_conf(filepath=None):
    fp = Path(filepath) if filepath else CONFIG_FILE
    conf = {}
    if fp.exists():
        for line in fp.read_text().splitlines():
            line = line.strip()
            if "=" in line and not line.startswith("#"):
                k, _, v = line.partition("=")
                conf[k.strip()] = v.strip().strip('"')
    conf.setdefault("vms_dir", str(Path.home() / "emu"))
    return conf

def setconf(key, value, filepath=None):
    fp = Path(filepath) if filepath else CONFIG_FILE
    content = fp.read_text() if fp.exists() else ""
    lines = content.splitlines()
    updated = False
    for i, line in enumerate(lines):
        if line.startswith(f"{key}="):
            lines[i] = f"{key}={value}"
            updated = True
            break
    if not updated:
        lines.append(f"{key}={value}")
    fp.write_text("\n".join(lines) + "\n")

def remove_key(key, filepath):
    fp = Path(filepath)
    if not fp.exists():
        return
    lines = [l for l in fp.read_text().splitlines() if not l.startswith(f"{key}=")]
    fp.write_text("\n".join(lines) + "\n")

def read_vm_conf(path):
    conf = {}
    try:
        for line in Path(path).read_text().splitlines():
            line = line.strip()
            if "=" in line and not line.startswith("#"):
                k, _, v = line.partition("=")
                conf[k.strip()] = v.strip().strip('"')
    except Exception:
        pass
    return conf

# ── VM helpers ─────────────────────────────────────────────────────────────────
def is_running(vmname):
    try:
        r = subprocess.run(["pgrep", "-f", f"quickemu.*{vmname}"],
                           capture_output=True, text=True)
        return bool(r.stdout.strip())
    except Exception:
        return False

def fmt_size(n):
    for u in ("B", "K", "M", "G", "T"):
        if n < 1024 or u == "T":
            return f"{n:.1f}{u}" if u != "B" else f"{n}B"
        n /= 1024

def dir_size(path):
    try:
        r = subprocess.run(["du", "-sh", path], capture_output=True, text=True)
        return r.stdout.split()[0] if r.stdout.strip() else ""
    except Exception:
        return ""

def get_vms(vms_dir):
    vms = []
    for conf_path in sorted(glob.glob(f"{vms_dir}/*.conf")):
        vm = read_vm_conf(conf_path)
        vm["_conf"]    = conf_path
        vm["_name"]    = Path(conf_path).stem
        vm["_pretty"]  = vm.get("pretty", vm["_name"])
        vm["_running"] = is_running(vm["_name"])
        disk = vm.get("disk_img", "")
        vm["_disk"]    = str(Path(vms_dir) / disk) if disk else ""
        vm["_has_disk"] = Path(vm["_disk"]).exists() if vm["_disk"] else False
        flag_path = Path(vms_dir) / f".{vm['_name']}.copying"
        vm["_copying"] = flag_path.exists()
        vm["_copy_total"] = ""
        if vm["_copying"]:
            try:
                vm["_copy_total"] = fmt_size(int(flag_path.read_text().strip()))
            except Exception:
                pass
        vm["_size"] = dir_size(str(Path(vms_dir) / vm["_name"]))
        vms.append(vm)
    return vms

def get_snapshots(disk_path):
    snaps = []
    try:
        r = subprocess.run(["qemu-img", "snapshot", "-l", disk_path],
                           capture_output=True, text=True)
        for line in r.stdout.splitlines()[2:]:
            parts = line.split()
            if len(parts) >= 2:
                snaps.append({"id": parts[0], "tag": parts[1]})
    except Exception:
        pass
    return snaps

def get_next_ssh_port(vms_dir, vmname):
    used = set()
    for conf_path in glob.glob(f"{vms_dir}/*.conf"):
        vm = read_vm_conf(conf_path)
        port = vm.get("ssh_port", "")
        if port:
            used.add(int(port))
    port = 2222
    while port in used:
        port += 1
    return str(port)

def _iso_label(vm, vms_dir):
    iso = vm.get("iso", "") or ""
    if not iso:
        return "—"
    if vm.get("_copying"):
        total = vm.get("_copy_total", "")
        return f"{iso}  ({total})" if total else iso
    try:
        size = fmt_size(Path(vms_dir, iso).stat().st_size)
        return f"{iso}  ({size})"
    except Exception:
        return iso

