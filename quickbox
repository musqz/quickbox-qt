def _resolve_quickget():
    """Find quickget, checking common locations GUI sessions may not have on PATH."""
    found = shutil.which("quickget")
    if found:
        return found
    for p in ["/usr/bin/quickget", "/usr/local/bin/quickget",
              str(Path.home() / ".local/bin/quickget")]:
        if Path(p).is_file() and os.access(p, os.X_OK):
            return p
    return None


# ── single-instance lock ───────────────────────────────────────────────────────
SOCKET_PATH = Path.home() / ".config/quickbox/quickbox-qt.sock"

def _acquire_lock():
    SOCKET_PATH.parent.mkdir(parents=True, exist_ok=True)
    try:
        c = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        c.connect(str(SOCKET_PATH))
        c.sendall(b"activate\n")
        c.close()
        sys.exit(0)
    except (ConnectionRefusedError, FileNotFoundError):
        pass
    try:
        SOCKET_PATH.unlink()
    except FileNotFoundError:
        pass
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    sock.bind(str(SOCKET_PATH))
    sock.listen(1)
    import atexit
    atexit.register(lambda: SOCKET_PATH.unlink(missing_ok=True))
    return sock

_lock_socket = _acquire_lock()

