# ── worker threads ─────────────────────────────────────────────────────────────
class SnapWorker(QThread):
    status  = Signal(str)
    done    = Signal(bool, str)

    def __init__(self, action, disk, tag, parent=None):
        super().__init__(parent)
        self.action = action  # "create" | "apply" | "delete"
        self.disk   = disk
        self.tag    = tag

    def run(self):
        if self.action == "create":
            r = subprocess.run(["qemu-img", "snapshot", "-c", self.tag, self.disk],
                               capture_output=True, text=True)
        elif self.action == "apply":
            r = subprocess.run(["qemu-img", "snapshot", "-a", self.tag, self.disk],
                               capture_output=True, text=True)
        elif self.action == "delete":
            r = subprocess.run(["qemu-img", "snapshot", "-d", self.tag, self.disk],
                               capture_output=True, text=True)
        else:
            self.done.emit(False, "unknown action")
            return
        self.done.emit(r.returncode == 0, r.stderr.strip())


class CopyWorker(QThread):
    progress = Signal(str, str)   # (current_size, total_size)
    done     = Signal(bool, str)

    def __init__(self, src, dst, flag_path, parent=None):
        super().__init__(parent)
        self.src  = src
        self.dst  = dst
        self.flag = flag_path

    def run(self):
        try:
            shutil.copytree(str(self.src), str(self.dst))
            Path(self.flag).unlink(missing_ok=True)
            self.done.emit(True, "")
        except Exception as e:
            Path(self.flag).unlink(missing_ok=True)
            self.done.emit(False, str(e))


class FormatWorker(QThread):
    status = Signal(str)
    done   = Signal(bool, str)

    def __init__(self, disk_path, size_gb, layout, parent=None):
        super().__init__(parent)
        self.disk    = disk_path
        self.size_gb = size_gb
        self.layout  = layout

    def run(self):
        try:
            self.status.emit(S["ntf_fmt_start"].format(self.size_gb))
            r = subprocess.run(
                ["qemu-img", "create", "-f", "qcow2", self.disk, f"{self.size_gb}G"],
                capture_output=True, text=True)
            if r.returncode != 0:
                self.done.emit(False, r.stderr.strip())
                return
            if self.layout != "raw":
                nbddev = "/dev/nbd0"
                subprocess.run(["modprobe", "nbd", "max_part=8"], capture_output=True)
                subprocess.run(["qemu-nbd", "--connect=" + nbddev, self.disk], capture_output=True)
                if self.layout == "gpt":
                    subprocess.run(["parted", "-s", nbddev, "mklabel", "gpt",
                                    "mkpart", "ESP", "fat32", "1MiB", "513MiB",
                                    "set", "1", "esp", "on",
                                    "mkpart", "root", "513MiB", "100%"], capture_output=True)
                    subprocess.run(["mkfs.fat", "-F32", nbddev + "p1"], capture_output=True)
                    subprocess.run(["mkfs.ext4", nbddev + "p2"], capture_output=True)
                elif self.layout == "msd":
                    subprocess.run(["parted", "-s", nbddev, "mklabel", "msdos",
                                    "mkpart", "primary", "ext4", "1MiB", "100%"], capture_output=True)
                    subprocess.run(["mkfs.ext4", nbddev + "p1"], capture_output=True)
                elif self.layout == "fat":
                    subprocess.run(["parted", "-s", nbddev, "mklabel", "msdos",
                                    "mkpart", "primary", "fat32", "1MiB", "100%"], capture_output=True)
                    subprocess.run(["mkfs.fat", "-F32", nbddev + "p1"], capture_output=True)
                subprocess.run(["qemu-nbd", "--disconnect", nbddev], capture_output=True)
            self.done.emit(True, "")
        except Exception as e:
            self.done.emit(False, str(e))


class ConvertWorker(QThread):
    status = Signal(str)
    done   = Signal(bool, str)

    def __init__(self, src, dst, parent=None):
        super().__init__(parent)
        self.src = src
        self.dst = dst

    def run(self):
        try:
            self.status.emit(S["ntf_converting"].format(Path(self.src).name))
            r = subprocess.run(
                ["qemu-img", "convert", "-f", "raw", "-O", "qcow2", self.src, self.dst],
                capture_output=True, text=True)
            if r.returncode == 0:
                subprocess.run(["qemu-img", "resize", self.dst, "20G"], capture_output=True)
            self.done.emit(r.returncode == 0, r.stderr.strip())
        except Exception as e:
            self.done.emit(False, str(e))


class DownloadWorker(QThread):
    progress = Signal(str, float)   # (text, fraction 0-1)
    done     = Signal(bool)

    def __init__(self, cmd, vms_dir, parent=None):
        super().__init__(parent)
        self.cmd     = cmd
        self.vms_dir = vms_dir
        self._cancel = False

    def cancel(self):
        self._cancel = True
        if hasattr(self, "_proc") and self._proc:
            try:
                self._proc.terminate()
            except Exception:
                pass

    def run(self):
        import math, time
        self.progress.emit(S["dl2_starting"], 0.0)
        t0 = time.monotonic()

        def _find_file():
            try:
                cutoff = t0 - 2.0
                files = []
                for f in Path(self.vms_dir).rglob("*"):
                    if f.is_file() and f.suffix.lower() in (
                            ".iso", ".img", ".qcow2", ".gz", ".xz", ".zip",
                            ".part", ".tmp", ".download"):
                        st = f.stat()
                        if st.st_mtime >= cutoff:
                            files.append((st.st_mtime, f))
                return sorted(files)[-1][1] if files else None
            except Exception:
                return None

        def _watch():
            elapsed, last_size, last_mb, target = 0, 0, 0.0, None
            while not self._cancel:
                time.sleep(1)
                elapsed += 1
                if target is None or not target.exists():
                    target = _find_file()
                if target and target.exists():
                    try:
                        size = target.stat().st_size
                        mb   = size / (1024 * 1024)
                        if size > last_size:
                            frac = math.log1p(mb) / (math.log1p(mb) + 8)
                            speed = (size - last_size) / (1024 * 1024)
                            last_mb, last_size = mb, size
                            self.progress.emit(
                                S["dl2_progress"].format(f"{mb:.0f}", f"{speed:.1f}"),
                                min(frac, 0.95))
                        else:
                            self.progress.emit(
                                S["dl2_progress"].format(f"{last_mb:.0f}", "–"),
                                min(math.log1p(last_mb) / (math.log1p(last_mb) + 8), 0.95))
                    except Exception:
                        pass
                else:
                    frac = min(math.log1p(elapsed / 10) / (math.log1p(elapsed / 10) + 6), 0.4)
                    self.progress.emit(S["dl2_connecting"].format(elapsed), frac)

        watcher = threading.Thread(target=_watch, daemon=True)
        watcher.start()
        try:
            self._proc = subprocess.Popen(
                self.cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                cwd=self.vms_dir)
            self._proc.wait()
            rc = self._proc.returncode
        except Exception:
            rc = 1
        self._cancel = True
        import time; time.sleep(1.2)
        if rc == 0:
            self.progress.emit(S["dl2_verifying"], 0.97)
            import time; time.sleep(1.0)
            self.progress.emit(S["dl2_done"], 1.0)
        else:
            self.progress.emit(S["dl2_failed"] if not self._cancel else S["dl2_cancelled"], 0.0)
        self.done.emit(rc == 0)


class UpdateDistroWorker(QThread):
    done = Signal(bool)
    def run(self):
        try:
            r = subprocess.run(["quickget", "--list-csv"], capture_output=True, text=True, timeout=60)
            if r.returncode == 0 and r.stdout.strip():
                out_path = Path.home() / ".config/quickbox/quickinst.csv"
                out_path.parent.mkdir(parents=True, exist_ok=True)
                out_path.write_text(r.stdout, encoding="utf-8")
                self.done.emit(True)
            else:
                self.done.emit(False)
        except Exception:
            self.done.emit(False)


