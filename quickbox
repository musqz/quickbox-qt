# ── worker threads ─────────────────────────────────────────────────────────────
class SnapWorker(QThread):
    status  = Signal(str)
    done    = Signal(bool, str)

    def __init__(self, action, disk, tag, parent=None):
        super().__init__(parent)
        self.action = action  # "create" | "apply" | "delete"
        self.disk   = disk
        self.tag    = tag

    def run(self):
        if self.action == "create":
            r = subprocess.run(["qemu-img", "snapshot", "-c", self.tag, self.disk],
                               capture_output=True, text=True)
        elif self.action == "apply":
            r = subprocess.run(["qemu-img", "snapshot", "-a", self.tag, self.disk],
                               capture_output=True, text=True)
        elif self.action == "delete":
            r = subprocess.run(["qemu-img", "snapshot", "-d", self.tag, self.disk],
                               capture_output=True, text=True)
        else:
            self.done.emit(False, "unknown action")
            return
        self.done.emit(r.returncode == 0, r.stderr.strip())


class CopyWorker(QThread):
    progress = Signal(str, str)   # (current_size, total_size)
    done     = Signal(bool, str)

    def __init__(self, src, dst, flag_path=None, orig_name="", parent=None):
        super().__init__(parent)
        self.src       = src
        self.dst       = dst
        self.flag      = flag_path
        self.orig_name = orig_name

    def run(self):
        ok, err = True, ""
        try:
            src = Path(self.src)
            if src.is_file():
                Path(self.dst).parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(str(src), str(self.dst))
            else:
                shutil.copytree(str(src), str(self.dst))
                dest_dir = Path(self.dst)
                for f in dest_dir.iterdir():
                    if f.stem == self.orig_name and f.suffix in {".sh", ".ports", ".log", ".pid"}:
                        f.unlink(missing_ok=True)
            if self.flag:
                Path(self.flag).unlink(missing_ok=True)
        except Exception as e:
            ok, err = False, str(e)
            if self.flag:
                Path(self.flag).unlink(missing_ok=True)
        self.done.emit(ok, err)


class FormatWorker(QThread):
    status = Signal(str)
    done   = Signal(bool, str)

    def __init__(self, disk_path, size_gb, layout, parent=None):
        super().__init__(parent)
        self.disk    = disk_path
        self.size_gb = size_gb
        self.layout  = layout

    def run(self):
        try:
            self.status.emit(S["ntf_fmt_start"].format(self.size_gb))
            r = subprocess.run(
                ["qemu-img", "create", "-f", "qcow2", self.disk, f"{self.size_gb}G"],
                capture_output=True, text=True)
            if r.returncode != 0:
                self.done.emit(False, r.stderr.strip())
                return
            if self.layout != "raw":
                nbddev = "/dev/nbd0"
                subprocess.run(["modprobe", "nbd", "max_part=8"], capture_output=True)
                subprocess.run(["qemu-nbd", "--connect=" + nbddev, self.disk], capture_output=True)
                if self.layout == "gpt":
                    subprocess.run(["parted", "-s", nbddev, "mklabel", "gpt",
                                    "mkpart", "ESP", "fat32", "1MiB", "513MiB",
                                    "set", "1", "esp", "on",
                                    "mkpart", "root", "513MiB", "100%"], capture_output=True)
                    subprocess.run(["mkfs.fat", "-F32", nbddev + "p1"], capture_output=True)
                    subprocess.run(["mkfs.ext4", nbddev + "p2"], capture_output=True)
                elif self.layout == "msd":
                    subprocess.run(["parted", "-s", nbddev, "mklabel", "msdos",
                                    "mkpart", "primary", "ext4", "1MiB", "100%"], capture_output=True)
                    subprocess.run(["mkfs.ext4", nbddev + "p1"], capture_output=True)
                elif self.layout == "fat":
                    subprocess.run(["parted", "-s", nbddev, "mklabel", "msdos",
                                    "mkpart", "primary", "fat32", "1MiB", "100%"], capture_output=True)
                    subprocess.run(["mkfs.fat", "-F32", nbddev + "p1"], capture_output=True)
                subprocess.run(["qemu-nbd", "--disconnect", nbddev], capture_output=True)
            self.done.emit(True, "")
        except Exception as e:
            self.done.emit(False, str(e))


class ConvertWorker(QThread):
    status = Signal(str)
    done   = Signal(bool, str)

    def __init__(self, src, dst, parent=None):
        super().__init__(parent)
        self.src = src
        self.dst = dst

    def run(self):
        try:
            self.status.emit(S["ntf_converting"].format(Path(self.src).name))
            r = subprocess.run(
                ["qemu-img", "convert", "-f", "raw", "-O", "qcow2", self.src, self.dst],
                capture_output=True, text=True)
            if r.returncode == 0:
                subprocess.run(["qemu-img", "resize", self.dst, "20G"], capture_output=True)
            self.done.emit(r.returncode == 0, r.stderr.strip())
        except Exception as e:
            self.done.emit(False, str(e))


class DownloadWorker(QThread):
    progress = Signal(str, float)   # (text, fraction 0-1)
    done     = Signal(bool)

    def __init__(self, cmd, vms_dir, parent=None):
        super().__init__(parent)
        self.cmd     = cmd
        self.vms_dir = vms_dir
        self._cancel = False

    def cancel(self):
        self._cancel = True
        if hasattr(self, "_proc") and self._proc:
            try:
                self._proc.terminate()
            except Exception:
                pass

    def run(self):
        import time, re, select as _sel, os as _os, shlex as _shlex
        self.progress.emit(S["dl2_starting"], -1.0)
        t0     = time.monotonic()
        total_mb    = None
        got_progress = False
        rc = 1

        def _fmt_size(mb):
            return f"{mb / 1024:.1f} GB" if mb >= 1024 else f"{mb:.0f} MB"

        try:
            qg_bin   = _resolve_quickget() or "quickget"
            cmd      = [qg_bin] + self.cmd[1:]
            _shell   = _os.environ.get("SHELL", "/bin/sh")
            _cmd_str = " ".join(_shlex.quote(c) for c in cmd)
            Path(self.vms_dir).mkdir(parents=True, exist_ok=True)
            self._proc = subprocess.Popen(
                [_shell, "-c", _cmd_str],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                cwd=self.vms_dir, bufsize=0)

            fd      = self._proc.stdout.fileno()
            buf     = b""
            _cl_re  = re.compile(r'^content-length:\s*(\d+)',    re.IGNORECASE)
            _cr_re  = re.compile(r'^content-range:[^/]*/(\d+)',  re.IGNORECASE)
            _pct_re = re.compile(r'([\d.]+)%')

            while True:
                ready = _sel.select([fd], [], [], 0.5)[0]
                if ready:
                    try:
                        chunk = _os.read(fd, 512)
                    except OSError:
                        break
                    if not chunk:
                        break
                    buf += chunk
                else:
                    if self._proc.poll() is not None:
                        break
                    if not got_progress:
                        elapsed = int(time.monotonic() - t0)
                        if elapsed <= 3:
                            self.progress.emit(S["dl2_starting"], -1.0)
                        else:
                            hint = "  —  slow servers may take a minute" if elapsed > 15 else ""
                            self.progress.emit(f"Contacting server… ({elapsed}s){hint}", -1.0)
                    continue

                while True:
                    r = buf.find(b"\r")
                    n = buf.find(b"\n")
                    if r == -1 and n == -1:
                        break
                    pos     = n if (r == -1 or (n != -1 and n < r)) else r
                    segment = buf[:pos].decode(errors="replace").strip()
                    buf     = buf[pos + 1:]
                    if not segment:
                        continue
                    m = _cl_re.search(segment)
                    if m:
                        total_mb = int(m.group(1)) / (1024 * 1024)
                        continue
                    m = _cr_re.search(segment)
                    if m:
                        total_mb = int(m.group(1)) / (1024 * 1024)
                        continue
                    m = _pct_re.search(segment)
                    if m:
                        pct = float(m.group(1))
                        got_progress = True
                        size_str = f" of {_fmt_size(total_mb)}" if total_mb else ""
                        self.progress.emit(
                            f"Downloading… {pct:.1f}%{size_str}",
                            min(pct / 100.0, 0.99))
                    elif not got_progress:
                        self.progress.emit(segment[:80], -1.0)

            if buf.strip():
                segment = buf.decode(errors="replace").strip()
                if not _pct_re.search(segment) and not got_progress:
                    self.progress.emit(segment[:80], -1.0)

            self._proc.wait()
            rc = self._proc.returncode
        except Exception:
            rc = 1

        time.sleep(1.2)
        if rc == 0:
            self.progress.emit(S["dl2_verifying"], 0.97)
            time.sleep(1.0)
            self.progress.emit(S["dl2_done"], 1.0)
        else:
            self.progress.emit(S["dl2_failed"] if not self._cancel else S["dl2_cancelled"], 0.0)
        self.done.emit(rc == 0)


class ResizeDiskWorker(QThread):
    done = Signal(bool)

    def __init__(self, disk_path, new_gb, parent=None):
        super().__init__(parent)
        self.disk   = disk_path
        self.new_gb = new_gb

    def run(self):
        ok = True
        try:
            subprocess.run(
                ["qemu-img", "resize", self.disk, f"{self.new_gb}G"],
                check=True, capture_output=True)
        except Exception:
            ok = False
        self.done.emit(ok)


class UpdateDistroWorker(QThread):
    done = Signal(bool, str)   # (ok, message)
    def run(self):
        try:
            qg_bin = _resolve_quickget() or "quickget"
            r = subprocess.run([qg_bin, "--list-csv"], capture_output=True, text=True, timeout=60)
            if r.returncode == 0 and r.stdout.strip():
                out_path = Path.home() / ".config/quickbox/quickinst.csv"
                out_path.parent.mkdir(parents=True, exist_ok=True)
                out_path.write_text(r.stdout, encoding="utf-8")
                count = sum(1 for line in r.stdout.splitlines()[1:] if line.strip())
                self.done.emit(True, f"✓ Updated — {count} distros")
            else:
                self.done.emit(False, f"✗ quickget returned no data (exit {r.returncode})")
        except FileNotFoundError:
            self.done.emit(False, "✗ quickget not found — install quickemu")
        except subprocess.TimeoutExpired:
            self.done.emit(False, "✗ Timed out (>60s)")
        except Exception as e:
            self.done.emit(False, f"✗ {e}")


