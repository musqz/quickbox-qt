        self._tray_menu.clear()
        running = [vm for vm in self.vms if vm.get("_running")]
        if running:
            self._tray_menu.addAction(self._tray_section(S["tray_sec_running"]))
            for vm in running:
                self._tray_menu.addAction(self._tray_vm_row(vm))
            self._tray_menu.addSeparator()
        self._tray_menu.addAction(self._tray_section(S["tray_sec_app"]))
        show_act = QAction(S["tray_show"], self)
        show_act.triggered.connect(self._tray_show)
        self._tray_menu.addAction(show_act)
        notif_act = QAction(S["tray_notifications"], self)
        notif_act.setCheckable(True)
        notif_act.setChecked(_notifications_on)
        notif_act.triggered.connect(self._set_notifications)
        self._tray_menu.addAction(notif_act)
        self._tray_menu.addSeparator()
        quit_act = QAction(S["tray_quit"], self)
        quit_act.triggered.connect(QApplication.quit)
        self._tray_menu.addAction(quit_act)

    def _set_notifications(self, enabled):
        global _notifications_on
        _notifications_on = enabled
        setconf("notifications", "true" if enabled else "false")
        self.conf["notifications"] = "true" if enabled else "false"

    def _stop_vm_by_name(self, name):
        self._tray_show()
        if not self._confirm(S["dlg_stop_t"].format(name), S["dlg_stop_b"]):
            return
        try:
            subprocess.run(["pkill", "-TERM", "-f", f"name {name},process={name}"])
        except Exception:
            pass
        self._poll_vm_state(name, want_running=False)

    def _tray_show(self):
        self.show()
        self.raise_()
        self.activateWindow()
        # restore windows hidden by the last toggle, raised above main
        for w in list(self._hidden_wins):
            w.show()
            w.raise_()
        self._hidden_wins.clear()

    def _tray_toggle(self):
        if self.isVisible():
            self._hidden_wins = [
                w for w in QApplication.topLevelWidgets()
                if w is not self and isinstance(w, QDialog) and w.isVisible()
            ]
            for w in self._hidden_wins:
                w.hide()
            self.hide()
        else:
            self._tray_show()

    def _on_tray_toggle(self, checked):
        setconf("systray", "true" if checked else "false")
        self.conf["systray"] = "true" if checked else "false"
        if checked:
            self._tray.show()
        else:
            self._tray.hide()

    def closeEvent(self, event):
        if self._tray.isVisible() and self.conf.get("systray") == "true":
            self.hide()
            event.ignore()
        else:
            self.conf["win_w"] = str(self.width())
            self.conf["win_h"] = str(self.height())
            setconf("win_w", str(self.width()))
            setconf("win_h", str(self.height()))
            event.accept()

    def focusNextPrevChild(self, next_child):
        focused = self.focusWidget()
        fl = self._right_focusable

        # Tab from VM list → first visible right-panel widget
        if focused is self._list and next_child and fl:
            for w in fl:
                if w.isVisibleTo(self) and w.isEnabled():
                    w.setFocus(Qt.FocusReason.TabFocusReason)
                    self._right_scroll.ensureWidgetVisible(w)
                    return True

        # Linear Tab through right panel
        if fl and focused in fl:
            idx  = fl.index(focused)
            step = 1 if next_child else -1
            for i in range(1, len(fl)):
                ni = idx + i * step
                if ni < 0 or ni >= len(fl):
                    break
                w = fl[ni]
                if w.isVisibleTo(self) and w.isEnabled():
                    w.setFocus(Qt.FocusReason.TabFocusReason)
                    self._right_scroll.ensureWidgetVisible(w)
                    return True
            # Exit panel
            (self._list if next_child else self._search).setFocus(Qt.FocusReason.TabFocusReason)
            return True

        return super().focusNextPrevChild(next_child)

    def _kb_escape(self):
        if self._search.text():
            self._search.clear()
            self._list.setFocus()
        elif self._search.hasFocus():
            self._list.setFocus()

    def _kb_list_enter(self, item):
        vm = item.data(Qt.ItemDataRole.UserRole) if item else self.current_vm
        if not vm:
            return
        if vm["_running"]:
            self._stop_vm(vm)
        else:
            self._launch_vm(vm)

    def _track_worker(self, worker):
        self._active_workers.add(worker)
        worker.finished.connect(
            lambda: self._active_workers.discard(worker),
            Qt.ConnectionType.QueuedConnection
        )

