    def _refresh_loc_list(self, container, dlg):
        # Clear and rebuild the saved locations list widget
        while container.layout() and container.layout().count():
            item = container.layout().takeAt(0)
            if item.widget():
                item.widget().deleteLater()
        if not container.layout():
            QVBoxLayout(container)

        conf = read_conf()
        found = False
        for i in range(1, 6):
            loc = conf.get(f"vms_dir_{i}", "")
            if not loc:
                continue
            found = True
            is_cur = (loc == self.vms_dir)
            row = QWidget()
            rl  = QHBoxLayout(row)
            rl.setContentsMargins(0, 2, 0, 2)

            lbl = QLabel()
            if is_cur:
                lbl.setText(f'<span style="color:#4caf50">✓</span>  {html.escape(loc)}')
            else:
                lbl.setText(f'     {html.escape(loc)}')
            lbl.setTextFormat(Qt.TextFormat.RichText)
            lbl.setSizePolicy(QSizePolicy.Policy.Expanding, QSizePolicy.Policy.Preferred)
            rl.addWidget(lbl)

            op_btn = QPushButton(S["btn_open_loc"])
            op_btn.setFixedWidth(60)
            op_btn.clicked.connect(lambda _, l=loc: subprocess.Popen(["xdg-open", l]))
            rl.addWidget(op_btn)

            rm_btn = QPushButton(S["btn_remove"])
            rm_btn.setFixedWidth(70)
            rm_btn.clicked.connect(lambda _, idx=i, c=container, d=dlg: (
                remove_key(f"vms_dir_{idx}", CONFIG_FILE),
                self.conf.pop(f"vms_dir_{idx}", None),
                self._refresh_loc_list(c, d)))
            rl.addWidget(rm_btn)

            sw_btn = QPushButton(S["btn_switch"])
            sw_btn.setFixedWidth(70)
            sw_btn.setEnabled(not is_cur)
            sw_btn.clicked.connect(lambda _, l=loc, d=dlg: self._switch_loc(l, d))
            rl.addWidget(sw_btn)
            container.layout().addWidget(row)

        if not found:
            nl = QLabel(S["adv_no_locs"])
            container.layout().addWidget(nl)

    def _switch_loc(self, loc, dlg):
        self.vms_dir = loc
        setconf("vms_dir", loc)
        self.conf["vms_dir"] = loc
        self.current_vm = None
        dlg.close()
        self._refresh()
        self._show_welcome()

    # ── migrate ───────────────────────────────────────────────────────────────────
    def _dlg_migrate(self):
        if not self.vms:
            self._warn(S["warn_no_vms_t"], S["warn_no_vms_b"])
            return
        dlg = QDialog(self)
        dlg.setWindowTitle(S["mig_title"])
        dlg.setWindowIcon(QIcon.fromTheme("qemu"))
        dlg.resize(480, 400)
        v = QVBoxLayout(dlg)
        v.addWidget(QLabel(S["mig_hint"]))

        all_btn = QPushButton(S["mig_all"])
        none_btn = QPushButton(S["mig_none"])
        hr = QHBoxLayout()
        hr.addWidget(all_btn); hr.addWidget(none_btn); hr.addStretch()
        v.addLayout(hr)

        checks = []
        for vm in self.vms:
            cb = QCheckBox(vm["_pretty"])
            cb.setProperty("vm", vm)
            checks.append(cb)
            v.addWidget(cb)

        all_btn.clicked.connect(lambda: [c.setChecked(True) for c in checks])
        none_btn.clicked.connect(lambda: [c.setChecked(False) for c in checks])

        pick_btn = QPushButton(S["btn_pick_dest"])
        v.addWidget(pick_btn)
        dest_lbl = QLabel("")
        v.addWidget(dest_lbl)
        dest = [None]

        def _pick():
            d = QFileDialog.getExistingDirectory(self, S["btn_pick_dest"], str(Path.home()))
            if d:
                dest[0] = d
                dest_lbl.setText(d)
        pick_btn.clicked.connect(_pick)

        btns = QDialogButtonBox(QDialogButtonBox.StandardButton.Ok | QDialogButtonBox.StandardButton.Cancel)
        btns.accepted.connect(dlg.accept)
        btns.rejected.connect(dlg.reject)
        v.addWidget(btns)

        if dlg.exec() != QDialog.DialogCode.Accepted or not dest[0]:
            return
        if dest[0] == self.vms_dir:
            self._warn(S["warn_same_loc_t"], S["warn_same_loc_b"])
            return

        selected = [c.property("vm") for c in checks if c.isChecked()]
        if not selected:
            return

        if not self._confirm(S["dlg_migrate_t"],
                             S["dlg_migrate_b"].format(len(selected), dest[0])):
            return

        prog = self._progress_dialog(S["mig_title"])

        def _do_migrate():
            ok = True
            for vm in selected:
                src = Path(self.vms_dir) / vm["_name"]
                dst = Path(dest[0]) / vm["_name"]
                dst_conf = Path(dest[0]) / f"{vm['_name']}.conf"
                try:
                    shutil.copytree(str(src), str(dst))
                    shutil.copy2(vm["_conf"], str(dst_conf))
                except Exception:
                    ok = False
            QMetaObject.invokeMethod(prog, "close", Qt.ConnectionType.QueuedConnection)
            if ok:
                QMetaObject.invokeMethod(self, "_ask_delete_originals",
                                         Qt.ConnectionType.QueuedConnection,
                                         Q_ARG(object, selected),
                                         Q_ARG(str, dest[0]))
            else:
                QMetaObject.invokeMethod(self, "_warn_migration_failed",
                                         Qt.ConnectionType.QueuedConnection)

        threading.Thread(target=_do_migrate, daemon=True).start()

    def _ask_delete_originals(self, selected, dest):
        r = QMessageBox.question(self, S["dlg_danger_t"],
            S["dlg_danger_b"].format(len(selected), self.vms_dir),
            QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No)
        if r == QMessageBox.StandardButton.Yes:
            for vm in selected:
                shutil.rmtree(str(Path(self.vms_dir) / vm["_name"]), ignore_errors=True)
                Path(vm["_conf"]).unlink(missing_ok=True)
        self._refresh()

    def _warn_migration_failed(self):
        self._warn(S["warn_mig_fail_t"], S["warn_mig_fail_b"])

    # ── helpers ───────────────────────────────────────────────────────────────────
    def _confirm(self, title, body):
        r = QMessageBox.question(self, title, body,
                                 QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No)
        return r == QMessageBox.StandardButton.Yes

    def _warn(self, title, body):
        QMessageBox.warning(self, title, body)

    def _progress_dialog(self, title):
        from PySide6.QtWidgets import QProgressDialog
        pd = QProgressDialog(S["prog_wait"], None, 0, 0, self)
        pd.setWindowTitle(title)
        pd.setWindowModality(Qt.WindowModality.ApplicationModal)
        pd.setMinimumDuration(0)
        pd.setValue(0)
        pd.show()
        QApplication.processEvents()
        return pd

    def _select_vm_by_name(self, name):
        for i in range(self._list.count()):
            vm = self._list.item(i).data(Qt.ItemDataRole.UserRole)
            if vm and vm["_name"] == name:
                self._list.setCurrentRow(i)
                break


