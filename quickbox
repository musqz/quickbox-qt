class SectionHeader(QWidget):
    def __init__(self, text, expanded, conf_key, conf, parent=None):
        super().__init__(parent)
        self.conf_key = conf_key
        self.conf     = conf
        self._content = []
        layout = QHBoxLayout(self)
        layout.setContentsMargins(0, 6, 0, 2)
        layout.setSpacing(0)

        self.lbl = QLabel(text)
        self.lbl.setStyleSheet("font-weight:bold; font-size:11px;")
        layout.addWidget(self.lbl, 1)

        sep = QFrame()
        sep.setFrameShape(QFrame.Shape.VLine)
        sep.setFrameShadow(QFrame.Shadow.Sunken)
        sep.setFixedHeight(14)
        sep.setStyleSheet("margin: 0 4px;")
        layout.addWidget(sep)

        self.btn = QPushButton(S["btn_hide"] if expanded else S["btn_show"])
        self.btn.setFlat(True)
        self.btn.setStyleSheet("font-size:11px; padding:0 2px;")
        self.btn.setFocusPolicy(Qt.FocusPolicy.TabFocus)
        self.btn.clicked.connect(self._toggle)
        layout.addWidget(self.btn)

        self._expanded = expanded

    def add_content(self, widget):
        self._content.append(widget)
        widget.setVisible(self._expanded)

    def _toggle(self):
        self._expanded = not self._expanded
        for w in self._content:
            w.setVisible(self._expanded)
        self.btn.setText(S["btn_hide"] if self._expanded else S["btn_show"])
        val = "true" if self._expanded else "false"
        setconf(self.conf_key, val)
        self.conf[self.conf_key] = val


class _TabFix(QObject):
    """Some widgets (QComboBox) consume Tab internally. Force it through focusNextPrevChild."""
    def __init__(self, win, parent=None):
        super().__init__(parent)
        self._win = win

    def eventFilter(self, obj, event):
        if event.type() != QEvent.Type.KeyPress:
            return False
        if event.key() == Qt.Key.Key_Tab:
            self._win.focusNextPrevChild(True)
            return True
        if event.key() == Qt.Key.Key_Backtab:
            self._win.focusNextPrevChild(False)
            return True
        return False


