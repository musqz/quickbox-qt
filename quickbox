    def _dlg_migrate(self):
        if not self.vms:
            self._warn(S["warn_no_vms_t"], S["warn_no_vms_b"])
            return

        dlg = QDialog(self)
        dlg.setWindowTitle(S["mig_title"])
        dlg.setWindowIcon(QIcon.fromTheme("quickbox"))
        dlg.resize(480, 460)
        v = QVBoxLayout(dlg)
        v.setSpacing(8)

        v.addWidget(QLabel(S["mig_hint"]))

        hr = QHBoxLayout()
        all_btn  = QPushButton(S["mig_all"])
        none_btn = QPushButton(S["mig_none"])
        hr.addWidget(all_btn); hr.addWidget(none_btn); hr.addStretch()
        v.addLayout(hr)

        # scrollable VM list
        scroll = QScrollArea()
        scroll.setWidgetResizable(True)
        scroll.setHorizontalScrollBarPolicy(Qt.ScrollBarPolicy.ScrollBarAlwaysOff)
        list_w = QWidget()
        list_v = QVBoxLayout(list_w)
        list_v.setSpacing(3)
        list_v.setContentsMargins(4, 4, 4, 4)
        scroll.setWidget(list_w)
        v.addWidget(scroll, 1)

        checks = []
        for vm in self.vms:
            running = vm["_running"]
            tag  = S["mig_running_tag"] if running else ""
            cb   = QCheckBox(f"{vm['_pretty']}  ({vm['_size']}){tag}")
            cb.setProperty("vm", vm)
            cb.setEnabled(not running)
            if running:
                cb.setToolTip(S["mig_stop_tt"])
            checks.append(cb)
            list_v.addWidget(cb)
        list_v.addStretch()

        all_btn.clicked.connect(lambda: [c.setChecked(True)  for c in checks if c.isEnabled()])
        none_btn.clicked.connect(lambda: [c.setChecked(False) for c in checks])

        # destination picker
        dest_row = QHBoxLayout()
        pick_btn = QPushButton(S["btn_pick_dest"])
        dest_lbl = QLabel(S["mig_no_dest"])
        dest_lbl.setStyleSheet("font-size:11px;")
        dest_row.addWidget(pick_btn)
        dest_row.addWidget(dest_lbl, 1)
        v.addLayout(dest_row)
        dest = [None]

        def _pick():
            d = QFileDialog.getExistingDirectory(self, S["btn_pick_dest"], str(Path.home()))
            if d:
                dest[0] = d
                dest_lbl.setText(d)
        pick_btn.clicked.connect(_pick)

        btns = QDialogButtonBox(QDialogButtonBox.StandardButton.Ok | QDialogButtonBox.StandardButton.Cancel)
        btns.accepted.connect(dlg.accept)
        btns.rejected.connect(dlg.reject)
        v.addWidget(btns)

        if dlg.exec() != QDialog.DialogCode.Accepted or not dest[0]:
            return
        if dest[0] == self.vms_dir:
            self._warn(S["warn_same_loc_t"], S["warn_same_loc_b"])
            return

        selected = [c.property("vm") for c in checks if c.isChecked()]
        if not selected:
            return

        names = "\n  • " + "\n  • ".join(v["_pretty"] for v in selected)
        if not self._confirm(S["dlg_migrate_t"],
                             S["dlg_migrate_b"].format(len(selected), dest[0], names)):
            return

        prog = self._progress_dialog(S["mig_title"])

        def _do_migrate():
            dest_dir = dest[0]
            Path(dest_dir).mkdir(parents=True, exist_ok=True)
            # one rsync call per VM (dir + conf)
            ok = True
            for vm in selected:
                vm_dir = Path(self.vms_dir) / vm["_name"]
                if vm_dir.exists():
                    r = subprocess.run(
                        ["rsync", "-a", f"{vm_dir}/",
                         f"{dest_dir}/{vm['_name']}/"],
                        capture_output=True)
                    if r.returncode != 0:
                        ok = False
                r2 = subprocess.run(
                    ["rsync", "-a", vm["_conf"], f"{dest_dir}/"],
                    capture_output=True)
                if r2.returncode != 0:
                    ok = False
            QMetaObject.invokeMethod(prog, "close", Qt.ConnectionType.QueuedConnection)
            if ok:
                self._sig_ask_delete_originals.emit(selected, dest_dir)
            else:
                self._sig_migration_failed.emit()

        threading.Thread(target=_do_migrate, daemon=True).start()

    def _ask_delete_originals(self, selected, dest):
        names = "\n  • " + "\n  • ".join(v["_pretty"] for v in selected)
        r = QMessageBox.question(self, S["dlg_danger_t"],
            S["dlg_danger_b"].format(len(selected), self.vms_dir, names),
            QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No)
        if r == QMessageBox.StandardButton.Yes:
            for vm in selected:
                shutil.rmtree(str(Path(self.vms_dir) / vm["_name"]), ignore_errors=True)
                Path(vm["_conf"]).unlink(missing_ok=True)
        self._refresh()
        self._show_welcome()

