        btns.rejected.connect(dlg.reject)
        v.addWidget(btns)

        if dlg.exec() != QDialog.DialogCode.Accepted:
            return

        save_first = not disk_unchanged and chk.isChecked()
        save_name  = name_entry.text().strip() if save_first else auto_tag

        def _do_apply():
            if save_first:
                self._sig_status.emit(S["snap_saving"].format(save_name))
                r = subprocess.run(["qemu-img", "snapshot", "-c", save_name, vm["_disk"]],
                                   capture_output=True)
                if r.returncode == 0:
                    notify("quickbox", S["snap_autosave_done"].format(save_name))
            self._sig_status.emit(S["snap_applying"].format(tag))
            r2 = subprocess.run(["qemu-img", "snapshot", "-a", tag, vm["_disk"]],
                                 capture_output=True, text=True)
            if r2.returncode == 0:
                setconf("current_snap", tag, vm["_conf"])
                setconf("snap_dirty", "false", vm["_conf"])
                vm["current_snap"] = tag
                notify("quickbox", S["ntf_snap_applied"].format(tag))
            self._sig_refresh_panel.emit(vm)

        threading.Thread(target=_do_apply, daemon=True).start()

