    # ── helpers ───────────────────────────────────────────────────────────────────
    def _confirm(self, title, body):
        r = QMessageBox.question(self, title, body,
                                 QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No)
        return r == QMessageBox.StandardButton.Yes

    def _warn(self, title, body):
        QMessageBox.warning(self, title, body)

    def _progress_dialog(self, title):
        from PySide6.QtWidgets import QProgressDialog
        pd = QProgressDialog(S["prog_wait"], "", 0, 0, self)
        pd.setCancelButton(None)
        pd.setWindowTitle(title)
        pd.setWindowIcon(QIcon.fromTheme("quickbox"))
        pd.setWindowModality(Qt.WindowModality.ApplicationModal)
        pd.setMinimumDuration(0)
        pd.setValue(0)
        pd.show()
        QApplication.processEvents()
        return pd

    def _select_vm_by_name(self, name):
        for i in range(self._list.count()):
            vm = self._list.item(i).data(Qt.ItemDataRole.UserRole)
            if vm and vm["_name"] == name:
                self._list.setCurrentRow(i)
                break


# ── application entry ──────────────────────────────────────────────────────────
class QuickboxApp(QApplication):
    def __init__(self, argv):
        super().__init__(argv)
        self.setApplicationName("Quickbox")
        self.setApplicationVersion(VERSION)
        self.setDesktopFileName("quickbox")
        self.setStyleSheet(APP_STYLE)
        self._register_icons()

    def _register_icons(self):
        for p in [
            Path(__file__).parent / "icons",
            Path.home() / ".local/share/quickbox/icons",
        ]:
            if p.exists():
                paths = QIcon.themeSearchPaths()
                if str(p) not in paths:
                    QIcon.setThemeSearchPaths([str(p)] + paths)
                break


def main():
    app = QuickboxApp(sys.argv)
    win = QuickboxWindow()
    win.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
