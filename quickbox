    def _clone_vm(self, vm):
        suggested = f"{vm['_name']}-{_date_tag()}"
        dlg = QDialog(self)
        dlg.setWindowTitle(S["clone_title"])
        dlg.setWindowIcon(QIcon.fromTheme("quickbox"))
