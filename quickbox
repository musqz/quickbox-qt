def _date_tag(with_time=False):
    try:
        fmt = _locale.nl_langinfo(_locale.D_FMT)
        d, m, y = fmt.index('%d'), fmt.find('%m'), max(fmt.find('%Y'), fmt.find('%y'))
        if d < m:        date_fmt = '%d-%m-%Y'
        elif y > m:      date_fmt = '%m-%d-%Y'
        else:            date_fmt = '%Y-%m-%d'
    except Exception:
        date_fmt = '%Y-%m-%d'
    now = datetime.datetime.now()
    return now.strftime(date_fmt) + (now.strftime('-%H%M') if with_time else '')

