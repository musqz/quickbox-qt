        close_btn = QPushButton(S["btn_close"])
        close_btn.clicked.connect(dlg.close)
        v.addWidget(close_btn)

        # populate
        letter_rows = {}
        all_items   = []
        for name, cmd in distros:
            first = name[0].upper() if name else "?"
            if first not in letter_rows:
                hdr_item = QListWidgetItem(f"── {first} ──")
                hdr_item.setFlags(Qt.ItemFlag.NoItemFlags)
                dist_list.addItem(hdr_item)
                letter_rows[first] = hdr_item
            item = QListWidgetItem(f"  {name}")
            item.setData(Qt.ItemDataRole.UserRole, (name, cmd))
            dist_list.addItem(item)
            all_items.append((name, cmd, item))

        # alphabet buttons
        for letter in sorted(letter_rows.keys()):
            btn = QPushButton(letter)
            btn.setFlat(True)
            btn.setFixedSize(34, 26)
            def _jump(_, ltr=letter, lrows=letter_rows, dl=dist_list):
                row = dl.row(lrows[ltr])
                dl.scrollToItem(lrows[ltr])
            btn.clicked.connect(_jump)
            alpha_v.addWidget(btn)
        alpha_v.addStretch()

        def _filter(text):
            t = text.strip().lower()
            for name, cmd, item in all_items:
                item.setHidden(bool(t) and t not in name.lower())
            for letter, hdr in letter_rows.items():
                any_visible = any(
                    not item.isHidden()
                    for n, c, item in all_items
                    if n and n[0].upper() == letter)
                hdr.setHidden(bool(t) and not any_visible)

        search.textChanged.connect(_filter)

        def _on_activate(item):
            data = item.data(Qt.ItemDataRole.UserRole)
            if data:
                name, cmd = data
                dlg.close()
                self._dlg_do_download(name, cmd, distros)

        dist_list.itemDoubleClicked.connect(_on_activate)
        dist_list.itemActivated.connect(_on_activate)
        dlg.exec()

    def _dlg_do_download(self, distro_name, distro_cmd, distros):
        cmd_parts  = distro_cmd.split()
        base_distro = cmd_parts[1] if len(cmd_parts) > 1 else distro_name
        versions = [(name, cmd) for name, cmd in distros
                    if len(cmd.split()) > 1 and cmd.split()[1].lower() == base_distro.lower()]
        if not versions:
            versions = [(distro_name, distro_cmd)]

        dlg = QDialog(self)
        dlg.setWindowTitle(f"Download — {base_distro}")
        dlg.setWindowIcon(QIcon.fromTheme("qemu"))
        dlg.resize(560, 320)
        v = QVBoxLayout(dlg)

        title = QLabel(f"<b><span style='font-size:15px'>{html.escape(base_distro.title())}</span></b>")
        title.setTextFormat(Qt.TextFormat.RichText)
        v.addWidget(title)
        v.addWidget(make_sep())

        vl = QLabel(S["dl2_ver_lbl"])
        v.addWidget(vl)
        ver_combo = QComboBox()
        for name, _ in versions:
            ver_combo.addItem(name)
        default_idx = next((i for i, (n, _) in enumerate(versions) if n == distro_name), 0)
        ver_combo.setCurrentIndex(default_idx)
        v.addWidget(ver_combo)

        cmd_lbl = QLabel(S["dl2_cmd_lbl"])
        v.addWidget(cmd_lbl)
        cmd_entry = QLineEdit(versions[default_idx][1])
        cmd_entry.setReadOnly(True)
        ver_combo.currentIndexChanged.connect(lambda i: cmd_entry.setText(versions[i][1]))
        v.addWidget(cmd_entry)
        v.addWidget(make_sep())

        progress = QProgressBar()
        progress.setRange(0, 1000)
        progress.setValue(0)
        progress.setFormat(S["dl2_ready"])
        progress.setTextVisible(True)
        v.addWidget(progress)

        note = QLabel(S["dl2_note"])
        note.setStyleSheet("font-size:11px;")
        v.addWidget(note)

        btn_row = QWidget()
        br = QHBoxLayout(btn_row)
        cancel_btn = QPushButton(S["btn_cancel"])
        dl_btn     = QPushButton(S["btn_download"])
        dl_btn.setStyleSheet("background:#1565c0;color:white;border-radius:5px;padding:5px 14px;font-weight:bold;")
        br.addStretch()
        br.addWidget(cancel_btn)
        br.addWidget(dl_btn)
        v.addWidget(btn_row)

        self._dl_worker = None
        t0 = [0.0]

        def _on_progress(text, frac):
            progress.setValue(int(frac * 1000))
            progress.setFormat(text)

        def _on_done(ok):
            import time
            elapsed = time.monotonic() - t0[0]
            m, s = divmod(int(elapsed), 60)
            dur = f"{m}m {s}s" if m else f"{s}s"
            if ok:
                note.setText(f"Downloaded in {dur}")
                dl_btn.setText(S["dl2_done_close"])
            else:
                dl_btn.setText(S["btn_close"])
            dl_btn.setEnabled(True)
            cancel_btn.setEnabled(False)
            self._refresh()

        def _start():
            import time
            t0[0] = time.monotonic()
            cmd = cmd_entry.text().strip().split()
            dl_btn.setEnabled(False)
            ver_combo.setEnabled(False)
            self._dl_worker = DownloadWorker(cmd, self.vms_dir)
            self._dl_worker.progress.connect(_on_progress)
            self._dl_worker.done.connect(_on_done)
            self._dl_worker.start()

        def _cancel():
            if self._dl_worker:
                self._dl_worker.cancel()
            dlg.close()

        dl_btn.clicked.connect(lambda: dlg.close() if dl_btn.text() in (S["dl2_done_close"], S["btn_close"]) else _start())
        cancel_btn.clicked.connect(_cancel)
        dlg.finished.connect(_cancel)
        dlg.exec()

